# 보안 예보 — 실행 환경 변수 예시 (비밀 값 없음)
#
# app/ · gpu/ · scripts/ · gpu/*.sh 가 실제로 읽는 변수만 적었다
#   (grep -rn 'os.environ' app gpu --include='*.py', 셸 스크립트의 ${VAR:-기본값}).
# 앱은 .env 파일을 자동으로 읽지 않는다. 필요하면 복사해 값을 고친 뒤 셸에 올린다:
#   cp .env.example .env && set -a && . ./.env && set +a && scripts/start_app.sh
# .env 는 .gitignore 에 있다(커밋되지 않음). 그래도 비밀 값은 적지 않는다.
# '~' 는 bash 에서 . ./.env 로 올릴 때 홈 경로로 펼쳐진다(2026-11-01 확인).
# 모든 변수는 생략 가능하다. 생략하면 주석에 적은 코드 기본값을 쓴다.
# '# ' 로 막아 둔 줄은 기본값을 그대로 쓰는 편이 안전한 것이다(상대 경로는 실행 위치에 따라 달라진다).
# 토큰·접근 코드 같은 비밀 값은 이 파일에 적지 말고 파일 경로나 실행 환경으로만 넘긴다.

# ── 운영 API (app/, scripts/start_app.sh) ─────────────────────────────
# 추론 API(GPU 서버) 주소. 코드 기본값은 대회 서버의 사설 주소다(app/main.py DEFAULT_GPU_URL).
# 로컬 개발에서 모의 GPU 서버(tools/mock_gpu.py)를 쓰면 그 주소를 넣는다(docs/LOCAL_DEV.md).
GPU_URL=http://127.0.0.1:8000
# GPU API 공유 토큰이 든 파일 경로(값이 아니라 경로). 앱과 GPU 서버가 같은 토큰 파일을 쓴다.
# 파일이 없으면 GPU 는 /health 외 요청을 401 로 막고, 앱은 LLM 없이 체크박스 방식으로 계속한다.
GPU_TOKEN_FILE=~/.config/sumeunjip/gpu_token
# 지식표(84행) 경로. 기본 data/knowledge.json
# KNOWLEDGE_PATH=data/knowledge.json
# 조문 스냅샷 경로. 기본 data/laws/articles.jsonl
# ARTICLES_PATH=data/laws/articles.jsonl
# 내부 LLM 기능(상황 정리·근거 답·다시 쓰기) 켜기/끄기. 0·false·off·no 면 끔. 기본 1(켬)
LLM_FEATURES=1
# 접근 코드 요구. 1 일 때만 ACCESS_CODE 와 요청 헤더 X-Access-Code 를 비교한다. 기본 꺼짐(피해자 본인 직접 사용, SPEC §7).
# 1 로 켰는데 ACCESS_CODE 가 비어 있으면 모든 요청을 막는다(fail-closed).
REQUIRE_ACCESS_CODE=0
# 접근 코드 값. 비밀이므로 여기 적지 말고 실행 환경에서만 넣는다.
# ACCESS_CODE=
# LLM 출력 가드의 '찾기 의도' 임베딩 점수 임곗값. app/llm.py 와 gpu/server.py 가 따로 읽으므로 두 서버에 같은 값을 넣는다. 기본 0.15
LLM_OUT_THRESH=0.15
# 운영 서버 바인드 주소·포트(scripts/start_app.sh). 외부에 열지 말고 ssh 터널로 접근한다.
APP_HOST=127.0.0.1
APP_PORT=8080

# ── 추론 API (gpu/server.py, gpu/verify.py, gpu/llm.py, gpu/start.sh) ──
# 모델 파일 폴더(HF_HOME 으로 쓰임). 실행 중에는 HF_HUB_OFFLINE=1 로 허브에 접속하지 않는다(start.sh 가 설정).
# 그래서 모델은 설치할 때 이 폴더로 미리 내려받아야 한다(README 「실행」, 리비전은 docs/evidence/repro-2026-11-01.md).
MODELS_DIR=~/models
# 입력 가드 임베딩 점수 '애매함' 경계(guard_holdout.json 으로 정함). 기본 0.02
INTENT_THRESH=0.02
# 다시 쓰기 출력 가드 임곗값·여유. 기본 0.15 · 0.05
LLM_REWRITE_THRESH=0.15
LLM_REWRITE_DELTA=0.05
# 다시 쓰기 정렬 비율 하한. 이보다 낮으면 모델 출력을 버리고 규칙 치환. 기본 0.6
REWRITE_ALIGN_MIN=0.6
# 근거 답 전체 시간 예산(초)·재생성에 필요한 남은 시간(초)·재순위 근거 하한. 기본 12 · 4 · 0.01
ANSWER_BUDGET_S=12
ANSWER_REGEN_MIN_S=4
VERIFY_RERANK_MIN=0.01
# 노출 금지 조문 12-gram 해시 파일. 기본 gpu/excluded_ngrams.json
# EXCLUDED_NGRAMS=gpu/excluded_ngrams.json
# 이 바이트를 넘는 요청 뒤 torch.cuda.empty_cache() 호출. 기본 4096
EMPTY_CACHE_BYTES=4096
# CUDA 메모리 단편화 완화(start.sh 기본값)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# 시험 전용: 1 이면 모델을 올리지 않는다(gpu/tests/conftest.py 가 설정). 운영에서는 비워 둔다.
# SUMEUNJIP_NO_LOAD=

# ── 내부 LLM (vLLM, gpu/llm_start.sh · gpu/llm.py) ─────────────────────
# vLLM OpenAI 호환 주소. 127.0.0.1 에만 바인드한다. 기본 http://127.0.0.1:8001/v1
LLM_URL=http://127.0.0.1:8001/v1
# 서빙 이름(llm_start.sh LLM_SERVED_NAME 과 gpu/llm.py LLM_MODEL 이 같아야 한다). 기본 qwen3-8b
LLM_SERVED_NAME=qwen3-8b
LLM_MODEL=qwen3-8b
# LLM 요청 타임아웃(초). 기본 60
LLM_TIMEOUT=60
# vLLM 가상환경·모델 폴더·GPU 메모리 비율(L4 23GB 중 0.6 ≈ 13.8GB). 기본 ~/vllm-venv · ~/models/Qwen3-8B-AWQ · 0.6
# LLM_MODEL_PATH 는 HF 캐시가 아니라 모델 파일을 그대로 둔 폴더다(hf download --local-dir 로 받은 곳).
VLLM_VENV=~/vllm-venv
LLM_MODEL_PATH=~/models/Qwen3-8B-AWQ
GPU_MEM_UTIL=0.6
